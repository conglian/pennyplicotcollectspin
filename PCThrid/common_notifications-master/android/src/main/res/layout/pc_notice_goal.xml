<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/pc_notice_root" android:layout_width="match_parent" android:layout_height="172dp" android:background="@drawable/pc_notice_white" android:orientation="vertical">
<FrameLayout android:layout_width="match_parent" android:layout_height="120dp">
<ImageView android:id="@+id/pc_notice_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription=""/>
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="22dp" android:orientation="vertical" android:gravity="center_horizontal">
<TextView android:id="@+id/pc_notice_title" android:layout_width="match_parent" android:layout_height="28dp" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="20sp" android:gravity="center" android:shadowColor="#000000" android:shadowRadius="2" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="20sp" android:autoSizeStepGranularity="1sp"/>
<TextView android:id="@+id/pc_notice_body" android:layout_width="match_parent" android:layout_height="60dp" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="top|center_horizontal" android:maxLines="3" android:shadowColor="#000000" android:shadowRadius="2"/>
</LinearLayout></FrameLayout>
<TextView android:id="@+id/pc_notice_button" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="8dp" android:background="@drawable/pc_notice_blue" android:gravity="center" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
</LinearLayout>
