<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 250:1217：展开态116高，金额独立绘制并读取真实缓存。 -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pc_notice_root" android:layout_width="match_parent"
    android:layout_height="116dp" android:background="@drawable/pc_notice_white" android:clipToOutline="true">
    <ImageView android:id="@+id/pc_notice_watermark" android:layout_width="68dp" android:layout_height="68dp"
        android:layout_alignParentEnd="true" android:layout_alignParentBottom="true" android:contentDescription="" />
    <TextView android:layout_width="match_parent" android:layout_height="16dp"
        android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginTop="12dp"
        android:includeFontPadding="false" android:gravity="center_vertical"
        android:text="You Pending Withdraw" android:textColor="#000000" android:textSize="12sp" />
    <ImageView android:id="@+id/pc_notice_icon" android:layout_width="52dp" android:layout_height="52dp"
        android:layout_marginStart="12dp" android:layout_marginTop="44dp"
        android:scaleType="fitCenter" android:contentDescription="App icon" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="24dp"
        android:layout_marginStart="76dp" android:layout_marginEnd="12dp" android:layout_marginTop="36dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/pc_notice_title" android:layout_width="wrap_content" android:layout_height="match_parent"
            android:gravity="center_vertical" android:includeFontPadding="false" android:maxLines="1"
            android:textColor="#000000" android:textSize="16sp" android:textStyle="bold" />
        <ImageView android:id="@+id/pc_notice_amount" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="24dp" android:layout_marginStart="4dp" android:scaleType="fitStart" android:contentDescription="" />
    </LinearLayout>
    <TextView android:id="@+id/pc_notice_button" android:layout_width="match_parent" android:layout_height="36dp"
        android:layout_marginStart="76dp" android:layout_marginEnd="12dp" android:layout_marginBottom="12dp"
        android:layout_alignParentBottom="true" android:background="@drawable/pc_notice_blue"
        android:gravity="center" android:includeFontPadding="false" android:textColor="#FFFFFF"
        android:textSize="14sp" android:textStyle="bold" android:maxLines="1" />
</RelativeLayout>
