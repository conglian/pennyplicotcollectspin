<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pc_notice_media_card"
    android:layout_width="match_parent" android:layout_height="48dp"
    android:background="@drawable/pc_notice_media_surface" android:clipToOutline="true">
    <ImageView
        android:layout_width="74dp" android:layout_height="74dp" android:layout_gravity="end|center_vertical"
        android:alpha="0.22" android:importantForAccessibility="no"
        android:scaleType="centerCrop" android:src="@drawable/pc_notice_account_icon" />
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center_vertical" android:orientation="vertical"
        android:paddingStart="14dp" android:paddingEnd="14dp">
        <TextView android:id="@+id/pc_notice_media_title"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1" android:textColor="#FFFFFF"
            android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/pc_notice_media_body"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
