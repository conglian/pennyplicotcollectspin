<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/pc_notice_media_card"
    android:layout_width="match_parent" android:layout_height="132dp"
    android:background="@drawable/pc_notice_media_surface" android:clipToOutline="true">
    <ImageView
        android:layout_width="144dp" android:layout_height="144dp"
        android:layout_gravity="center_vertical|end" android:layout_marginEnd="18dp"
        android:alpha="0.26" android:importantForAccessibility="no"
        android:scaleType="fitCenter" android:src="@drawable/pc_notice_account_icon" />
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center_vertical" android:orientation="vertical"
        android:paddingStart="16dp" android:paddingEnd="16dp">
        <TextView android:id="@id/pc_notice_media_title"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="2" android:textColor="#FFFFFF"
            android:textSize="17sp" android:textStyle="bold" />
        <TextView android:id="@id/pc_notice_media_body"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:ellipsize="end" android:maxLines="2" android:textColor="#FFFFFF" android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
